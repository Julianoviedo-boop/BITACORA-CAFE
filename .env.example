# Copie este archivo como .env y llene los valores. Nunca suba el .env al repositorio.

# --- Aplicación ---
APP_ENV=development
APP_SECRET_KEY=cambie-esto
LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=bitacora
POSTGRES_PASSWORD=cambie-esto
POSTGRES_DB=bitacora_cafe
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://bitacora:cambie-esto@db:5432/bitacora_cafe

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Cada cuántos minutos se revisan las alertas por tiempo (Celery beat).
ALERTAS_REVISION_MINUTOS=30

# --- WhatsApp ---
# openbsp = WhatsApp real; fake = no envía nada (desarrollo, pruebas, simulador)
WHATSAPP_CHANNEL=fake
# Instancia alojada de OpenBSP (o la URL de Supabase si es autoalojado)
OPENBSP_BASE_URL=https://nheelwshzbgenpavwhcy.supabase.co
# Header apikey: llave pública (publishable) de Supabase
OPENBSP_PUBLISHABLE_KEY=
# Header api-key: OpenBSP > Settings > API Keys (rol member basta para leer y enviar)
OPENBSP_API_KEY=
# Id de la organización en OpenBSP: GET /rest/v1/organizations?select=id,name
OPENBSP_ORGANIZATION_ID=
# Secreto de la URL del webhook (mínimo 32 caracteres). Genérelo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# URL a registrar en OpenBSP: https://<su-dominio>/webhooks/openbsp/<OPENBSP_WEBHOOK_SECRET>
OPENBSP_WEBHOOK_SECRET=
# El "token" del webhook en OpenBSP (llega como Authorization: Bearer). Mínimo 32
# caracteres; se genera igual que el secreto y se pega en el campo "token" del
# webhook en OpenBSP. OBLIGATORIO con APP_ENV=production: sin él la API no arranca.
# En desarrollo es opcional.
OPENBSP_WEBHOOK_TOKEN=
# El número receptor de cada organización (phone_number_id) se guarda en
# organizations.whatsapp_address, no aquí.

# --- Transcripción (faster-whisper) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es
# Hilos por proceso del worker (0 = automático). Con --concurrency=2 en 4 núcleos, use 2.
WHISPER_CPU_THREADS=0

# --- Extracción (API de Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Cuánto piensa el modelo antes de responder: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# --- Panel web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Token con el que el servidor del panel le pide datos a la API (mínimo 32
# caracteres; se genera igual que el secreto del webhook). Lo usan la api y el panel.
# Vacío = el panel no muestra lotes. Ver docs/decisiones.md, D-020.
PANEL_API_TOKEN=
# Organización que ve el panel (su id, un UUID). El token solo sirve para ella.
PANEL_ORGANIZATION_ID=
# Usuario y clave para entrar al panel. En producción, sin ellos el panel no abre;
# en desarrollo se puede entrar sin clave.
PANEL_USUARIO=
PANEL_CLAVE=
# Dirección del panel, sin "/" al final. El QR del reporte PDF lleva a
# <PUBLIC_WEB_URL>/l/<token>. En producción se arma sola con WEB_DOMAIN.
PUBLIC_WEB_URL=http://localhost:3000

# --- Producción (solo en el servidor; ver docs/despliegue.md) ---
# En el servidor quite el "# " de estas líneas. En desarrollo déjelas comentadas.
# Hace que "docker compose" use el archivo de producción sin escribir -f.
# COMPOSE_FILE=docker-compose.prod.yml
# Dueño de las imágenes en GHCR, en minúsculas (usuario u organización de GitHub).
# GHCR_OWNER=su-usuario-de-github
# Versión desplegada. La cambia scripts/desplegar.sh; no la edite a mano.
# IMAGE_TAG=sha-1a2b3c4
# Dominios (sus registros DNS deben apuntar a la IP del servidor) y correo para Let's Encrypt.
# API_DOMAIN=api.su-dominio.com
# WEB_DOMAIN=panel.su-dominio.com
# ACME_EMAIL=correo-para-avisos-de-certificados@su-dominio.com

# --- Copias de seguridad (scripts/respaldo_db.sh) ---
# Remoto de rclone CIFRADO donde quedan los respaldos (ver docs/despliegue.md).
# RESPALDO_REMOTO=bitacora-cifrado:postgres
# RESPALDO_DIR=/var/backups/bitacora-cafe
# RESPALDO_DIAS_LOCAL=7
# RESPALDO_DIAS_REMOTO=30
# Opcional: URL de healthchecks.io (u otro) que se llama si el respaldo salió bien;
# si un día no llega, ese servicio le avisa.
# RESPALDO_AVISO_URL=
#jjsjsjsjsn