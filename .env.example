# Copie este archivo como .env y llene los valores. Nunca suba el .env al repositorio.

# --- Aplicación ---
APP_ENV=development
APP_SECRET_KEY=cambie-esto
LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=bitacora
POSTGRES_PASSWORD=cambie-esto
POSTGRES_DB=bitacora_cafe
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://bitacora:cambie-esto@db:5432/bitacora_cafe

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- WhatsApp (OpenBSP) ---
OPENBSP_BASE_URL=
OPENBSP_API_KEY=
OPENBSP_WEBHOOK_SECRET=
OPENBSP_PHONE_NUMBER_ID=

# --- Transcripción (faster-whisper) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es

# --- Extracción (API de Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Panel web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
