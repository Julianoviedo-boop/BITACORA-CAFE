{"id": "sint01_abonada", "origen": "sintetico_01_abonada.txt", "texto": "Buenos días. Hoy abonamos el lote El Mirador con diecisiete seis dieciocho. Le echamos cuatro bultos y trabajaron tres jornaleros toda la mañana.", "recibido_en": "2026-11-12T12:30:00-05:00", "lotes": [{"codigo": "MIR-01", "nombre": "La Esperanza", "variedad": "Castillo", "finca": "El Mirador"}, {"codigo": "MIR-02", "nombre": "El Guamo", "variedad": "Caturra", "finca": "El Mirador"}, {"codigo": "BUE-01", "nombre": "La Loma", "variedad": "Geisha", "finca": "Buenavista"}, {"codigo": "BUE-02", "nombre": "El Mirador", "variedad": "Castillo", "finca": "Buenavista"}], "esperado": [{"tipo_evento": "abonada", "codigo_lote": "BUE-02", "fecha": "2026-11-12", "hora": null, "datos": {"insumo": {"valor": "17-6-18"}, "cantidad": {"valor": 4, "unidad": "bulto"}, "jornales": {"valor": 3, "unidad": ["persona", "jornal"]}}, "faltantes": []}]}
{"id": "sint02_fumigacion_sin_producto", "origen": "sintetico_02_fumigacion.txt", "texto": "Ayer fumigamos el lote La Esperanza contra la broca. Usamos dos litros por caneca y nos gastamos seis canecas. Ese lote es de variedad Castillo.", "recibido_en": "2026-11-12T07:30:00-05:00", "lotes": [{"codigo": "MIR-01", "nombre": "La Esperanza", "variedad": "Castillo", "finca": "El Mirador"}, {"codigo": "MIR-02", "nombre": "El Guamo", "variedad": "Caturra", "finca": "El Mirador"}, {"codigo": "BUE-01", "nombre": "La Loma", "variedad": "Geisha", "finca": "Buenavista"}, {"codigo": "BUE-02", "nombre": "El Mirador", "variedad": "Castillo", "finca": "Buenavista"}], "esperado": [{"tipo_evento": "fumigacion", "codigo_lote": "MIR-01", "fecha": "2026-11-11", "hora": null, "datos": {"objetivo": {"valor": "broca"}, "dosis": {"valor": 2, "unidad": "litro_por_caneca"}, "volumen": {"valor": 6, "unidad": "caneca"}}, "faltantes": ["producto"]}]}
{"id": "sint03_recoleccion_esta_semana", "origen": "sintetico_03_recoleccion.txt", "texto": "Esta semana fue la recolección del lote número dos. Cogimos ochocientos kilos de cereza con cinco recolectores. Despulpamos el mismo día y lo dejamos fermentando.", "recibido_en": "2026-11-12T07:30:00-05:00", "lotes": [{"codigo": "LOTE-001", "nombre": "Lote 1", "variedad": "Castillo", "finca": "La Ceiba"}, {"codigo": "LOTE-002", "nombre": "Lote 2", "variedad": "Colombia", "finca": "La Ceiba"}, {"codigo": "LOTE-003", "nombre": "El Alto", "variedad": "Caturra", "finca": "La Ceiba"}, {"codigo": "LOTE-004", "nombre": "La Quebrada", "variedad": "Castillo", "finca": "La Ceiba"}], "esperado": [{"tipo_evento": "recoleccion", "codigo_lote": "LOTE-002", "fecha": null, "hora": null, "datos": {"cantidad_cereza": {"valor": 800, "unidad": "kg"}, "recolectores": {"valor": 5, "unidad": "persona"}}, "faltantes": ["fecha"]}, {"tipo_evento": "beneficio", "codigo_lote": "LOTE-002", "fecha": null, "hora": null, "datos": {"etapa": {"valor": "despulpado fermentación"}}, "faltantes": ["fecha"]}]}
{"id": "sint04_roya_y_plan", "origen": "sintetico_04_roya.txt", "texto": "Le cuento que en el lote de Caturra apareció roya en varias matas, sobre todo en la parte de abajo. Toca fumigar la otra semana. También hicimos el plateo y la desyerba con guadaña.", "recibido_en": "2026-11-12T07:30:00-05:00", "lotes": [{"codigo": "MIR-01", "nombre": "La Esperanza", "variedad": "Castillo", "finca": "El Mirador"}, {"codigo": "MIR-02", "nombre": "El Guamo", "variedad": "Caturra", "finca": "El Mirador"}, {"codigo": "BUE-01", "nombre": "La Loma", "variedad": "Geisha", "finca": "Buenavista"}, {"codigo": "BUE-02", "nombre": "El Mirador", "variedad": "Castillo", "finca": "Buenavista"}], "esperado": [{"tipo_evento": "monitoreo_sanitario", "codigo_lote": "MIR-02", "fecha": null, "hora": null, "datos": {"problema": {"valor": "roya"}, "afectacion": {"valor": "varias matas parte de abajo"}}, "faltantes": ["fecha"]}, {"tipo_evento": "desyerba", "codigo_lote": "MIR-02", "fecha": null, "hora": null, "datos": {"metodo": {"valor": "guadaña"}}, "faltantes": ["fecha"]}]}
{"id": "sint05_resumen_semana", "origen": "sintetico_05_resumen_semana.txt", "texto": "Bueno, le hago el resumen de la semana. El lunes terminamos de secar el café en la marquesina, quedaron doce arrobas de pergamino seco. El martes vendimos diez arrobas en la cooperativa y guardamos el resto. El miércoles hicimos traviesa en el lote El Mirador, salieron como trescientos kilos de cereza. El jueves llovió todo el día y no se pudo trabajar. Y hoy viernes echamos cal dolomita en el lote nuevo, como medio bulto por cada surco.", "recibido_en": "2026-11-13T18:00:00-05:00", "lotes": [{"codigo": "MIR-01", "nombre": "La Esperanza", "variedad": "Castillo", "finca": "El Mirador"}, {"codigo": "MIR-02", "nombre": "El Guamo", "variedad": "Caturra", "finca": "El Mirador"}, {"codigo": "BUE-01", "nombre": "La Loma", "variedad": "Geisha", "finca": "Buenavista"}, {"codigo": "BUE-02", "nombre": "El Mirador", "variedad": "Castillo", "finca": "Buenavista"}], "esperado": [{"tipo_evento": "secado", "codigo_lote": null, "fecha": "2026-11-09", "hora": null, "datos": {"cantidad_seco": {"valor": 12, "unidad": "arroba"}, "metodo": {"valor": "marquesina"}}, "faltantes": ["lote"]}, {"tipo_evento": "venta", "codigo_lote": null, "fecha": "2026-11-10", "hora": null, "datos": {"cantidad": {"valor": 10, "unidad": "arroba"}, "comprador": {"valor": "cooperativa"}, "tipo_cafe": {"valor": "pergamino seco", "opcional": true}}, "faltantes": []}, {"tipo_evento": "recoleccion", "codigo_lote": "BUE-02", "fecha": "2026-11-11", "hora": null, "datos": {"cantidad_cereza": {"valor": 300, "unidad": "kg"}, "pase": {"valor": "traviesa"}}, "faltantes": []}, {"tipo_evento": "abonada", "codigo_lote": null, "fecha": "2026-11-13", "hora": null, "datos": {"insumo": {"valor": "cal dolomita"}, "dosis": {"valor": 0.5, "unidad": "bulto_por_surco"}}, "faltantes": ["lote", "cantidad"]}]}
