# Todos los días a las 3:15 a. m. (hora del servidor). Persistent=true: si el
# servidor estaba apagado a esa hora, corre apenas arranque.
[Unit]
Description=Bitácora de Café: respaldo diario de PostgreSQL

[Timer]
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
