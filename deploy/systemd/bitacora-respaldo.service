# Respaldo diario de PostgreSQL. Se instala con los pasos de docs/despliegue.md.
# Ajuste User= y las rutas si el repositorio no está en /opt/bitacora-cafe.
[Unit]
Description=Bitácora de Café: respaldo de PostgreSQL
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/bitacora-cafe
ExecStart=/opt/bitacora-cafe/scripts/respaldo_db.sh
Nice=10
